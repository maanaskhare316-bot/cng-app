# CNG Navigator Configuration Example

# Server Port (Default: 8080)
SERVER_PORT=8080

# Google Gemini API Key
# If omitted or left empty, the application seamlessly runs in Demo Mode with simulated Gemini 3.8 Flash intelligence
GEMINI_API_KEY=YOUR_GEMINI_API_KEY_HERE

# Google Maps Platform Server / Web API Key
GOOGLE_MAPS_API_KEY=YOUR_GOOGLE_MAPS_KEY_HERE

# Administrative Secret Key for Station Telemetry & Updates
ADMIN_SECRET_KEY=cng-admin-secret-2026

# Database Profile Configuration:
# - Default: 'default' (uses persistent embedded H2 in PostgreSQL compatibility mode; requires ZERO installation)
# - PostgreSQL: Set SPRING_PROFILES_ACTIVE=postgres and configure connection details below:
# SPRING_PROFILES_ACTIVE=postgres
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/cng_navigator
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=postgres
